# Copy this file to `.env` in the REPOSITORY ROOT (not in demo/) and fill in values.
# The demo and the pipeline read it via python-dotenv.

# --- GeoNames (required) -----------------------------------------------------
# A free GeoNames account WITH the free web service enabled at
# https://www.geonames.org/manageaccount  (this is a separate opt-in checkbox!)
GEONAMES_USERNAME=your_geonames_username

# --- LLM endpoint ------------------------------------------------------------
# Point the pipeline at your self-hosted vLLM server. Set ONE of the two:
# NATIVE path (vLLM runs directly on the host) — use the port you served vLLM on
# (8000 is often taken on a shared box, so we default to 8001):
CHATAI_BASE_URL=http://localhost:8001/v1
# DOCKER path (docker-compose) — the demo reaches vLLM by the compose service name:
# CHATAI_BASE_URL=http://vllm:8000/v1

# vLLM does not require a key unless you start it with --api-key. The client
# still needs a non-empty value here; use the same token you pass to vLLM
# (or just "dummy" if you did not set --api-key on vLLM).
SAIA_API_KEY=dummy

# Model names MUST equal the vLLM --served-model-name (see DEPLOYMENT.md).
DEMO_ACTOR_MODEL=georelating-llm
DEMO_CRITIC_MODEL=georelating-llm

# Hybrid "thinking" models (e.g. the default Qwen3.6-35B-A3B, served with
# --enforce-eager so it fits a 46 GB L40S) emit slow <think> reasoning by default.
# Set this to force non-thinking mode (sent as chat_template_kwargs to vLLM).
# REQUIRED for Qwen3.x hybrid models; leave false for a dedicated Instruct model
# (e.g. Qwen3-30B-A3B-Instruct-2507-FP8). See the latency analysis in DEPLOYMENT.md.
LLM_DISABLE_THINKING=true

# --- Misc --------------------------------------------------------------------
TOKENIZERS_PARALLELISM=false
# Concurrent georelating jobs the demo will run at once (each uses several LLM calls).
DEMO_MAX_WORKERS=2
